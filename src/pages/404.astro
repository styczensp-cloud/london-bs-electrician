---
import Layout from '../layouts/Layout.astro';
const title = 'Page Not Found | London BS Ltd';
const description = 'This page could not be found. Find electrical services from London BS Ltd, a NICEIC registered electrician based in Dunstable, or call 07427 670610.';
---
<Layout title={title} description={description}>
<meta slot="head" name="robots" content="noindex">
<section class="page-hero">
  <div class="container">
    <h1 class="page-hero__title">Page not found</h1>
    <p class="page-hero__body">This page has moved or no longer exists. Use the links below or call us on 07427 670610.</p>
  </div>
</section>
<div class="related-strip">
  <div class="container">
    <p class="related-strip__label">Where to next</p>
    <div class="related-strip__links">
      <a href="/" class="btn btn--outline-brown" style="font-size:0.87rem;">Home</a>
      <a href="/electrical-services" class="btn btn--outline-brown" style="font-size:0.87rem;">Electrical Services</a>
      <a href="/service-areas" class="btn btn--outline-brown" style="font-size:0.87rem;">Service Areas</a>
      <a href="/contact" class="btn btn--outline-brown" style="font-size:0.87rem;">Contact</a>
    </div>
  </div>
</div>
</Layout>
