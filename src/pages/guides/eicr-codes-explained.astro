const schema = [{"@context":"https://schema.org","@type":"Article","headline":"EICR Codes Explained","publisher":{"@type":"Organization","name":"London BS Ltd","url":"https://londonbs.uk"}},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://londonbs.uk/"},{"@type":"ListItem","position":2,"name":"EICR","item":"https://londonbs.uk/eicr"},{"@type":"ListItem","position":3,"name":"EICR Codes Explained","item":"https://londonbs.uk/guides/eicr-codes-explained"}]}];
