const schema = [
  {"@context":"https://schema.org","@type":"Service","name":"Consumer Unit Replacement","provider":{"@type":"LocalBusiness","name":"London BS Ltd"},"areaServed":[{"@type":"City","name":"Dunstable"},{"@type":"City","name":"Luton"}],"serviceType":"Consumer Unit Replacement"},
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://londonbs.uk/"},{"@type":"ListItem","position":2,"name":"Consumer Unit Changes","item":"https://londonbs.uk/consumer-unit-changes"}]},
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does a consumer unit replacement take?","acceptedAnswer":{"@type":"Answer","text":"A straightforward consumer unit replacement typically takes four to eight hours in a single visit."}},{"@type":"Question","name":"Is a consumer unit replacement notifiable under Building Regulations?","acceptedAnswer":{"@type":"Answer","text":"Yes. Replacing a consumer unit is notifiable work under Part P. We handle the notification and issue an Electrical Installation Certificate on completion."}},{"@type":"Question","name":"Will replacing the consumer unit fix my electrical problems?","acceptedAnswer":{"@type":"Answer","text":"A new consumer unit addresses protection at the distribution board — it does not fix problems in the wiring itself. We will advise you honestly before any work begins."}}]}
