---
import Layout from '../layouts/Layout.astro';
import TikTokSection from '../components/tiktok/TikTokSection.astro';
import LukasSection from '../components/LukasSection.astro';
import { locations } from '../data/locations';
import { googleReviews, ratedPeopleReviews, formatRating } from '../data/reviews';

const title = 'Electrician in Dunstable | EICR & Rewires | London BS Ltd';
const description = 'NICEIC registered electrician based in Dunstable LU6. EICR reports, consumer unit upgrades, rewires and fault finding. Also covering Luton and Milton Keynes.';

const googleRating = formatRating(googleReviews.rating);
const ratedPeopleRating = formatRating(ratedPeopleReviews.rating);

const faqs = [
  {
    q: 'Are you based in Dunstable?',
    a: 'Yes. London BS Ltd is based at 10 Meadway, Dunstable LU6 3JU. Dunstable is our home area, and we also cover the surrounding towns and villages.',
  },
  {
    q: 'Can you issue a landlord EICR in Dunstable?',
    a: 'Yes. As a NICEIC registered contractor we carry out landlord EICRs on rental properties in Dunstable and issue the report landlords need under the Electrical Safety Standards in the Private Rented Sector (England) Regulations 2020.',
  },
  {
    q: 'Which areas near Dunstable do you cover?',
    a: 'Around Dunstable we cover the town centre, Houghton Regis, Totternhoe, Kensworth, Eaton Bray and Caddington. We also cover Luton, Milton Keynes and Leighton Buzzard.',
  },
];

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Electrician",
    "@id": `${site}/#business`,
    "name": "London BS Ltd",
    "legalName": "LONDON BS LTD",
    "description": "NICEIC registered electrician based in Dunstable. EICR reports, consumer unit upgrades, house rewires, fault finding and emergency electrical work.",
    "url": `${site}/`,
    "telephone": "07427 670610",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "10 Meadway",
      "addressLocality": "Dunstable",
      "postalCode": "LU6 3JU",
      "addressCountry": "GB"
    },
    "areaServed": [
      "Dunstable","Houghton Regis","Totternhoe","Kensworth","Eaton Bray","Caddington",
      "Luton","Milton Keynes","Leighton Buzzard",
      "Toddington","Harpenden","St Albans","Hemel Hempstead","Flitwick","Ampthill","Bedford","Bletchley"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": googleRating,
      "reviewCount": googleReviews.count,
      "bestRating": "5"
    },
    "openingHours": "Mo-Su 00:00-23:59"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(({ q, a }) => ({
      "@type": "Question",
      "name": q,
      "acceptedAnswer": { "@type": "Answer", "text": a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site}/#website`,
    "url": site,
    "name": "London BS Ltd"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{"@type":"ListItem","position":1,"name":"Home","item":`${site}/`}]
  }
];
---
<Layout title={title} description={description} schema={schema}>

<section class="hero">
  <div class="container hero__inner">

    <div class="hero__left">
      <p class="hero__label">NICEIC Registered · Dunstable LU6</p>
      <h1 class="hero__title">Electrician in <em>Dunstable</em></h1>
      <p class="hero__body">London BS Ltd is based in Dunstable and carries out EICR reports, consumer unit upgrades, rewires, fault finding and electrical work across the town and the LU6 area. We also cover <a href="/electrician-luton">Luton</a>, <a href="/electrician-milton-keynes">Milton Keynes</a>, <a href="/electrician-leighton-buzzard">Leighton Buzzard</a> and <a href="/electrician-houghton-regis">Houghton Regis</a>, with selected London projects by arrangement.</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary btn--lg">Get a Quote</a>
        <a href="tel:07427670610" class="btn btn--outline btn--lg">Call 07427 670610</a>
        <a href="https://wa.me/447427670610" class="btn btn--outline btn--lg">WhatsApp</a>
      </div>
      <a href={googleReviews.url} target="_blank" rel="noopener noreferrer" class="hero__rating">
        <span class="hero__rating-stars" aria-hidden="true">★★★★★</span>
        <span class="hero__rating-score">{googleRating}</span>
        <span class="hero__rating-text">Rated <strong>{googleRating}</strong> from <strong>{googleReviews.count} Google reviews</strong> &amp; <strong>{ratedPeopleReviews.count}</strong> on Rated People</span>
      </a>
      <div class="hero__trust">
        <span class="hero__trust-badge">NICEIC Registered</span>
        <span>EICR reports &middot; Rewires &middot; Consumer units &middot; Dunstable LU6</span>
      </div>
    </div>

    <div class="hero__right" aria-hidden="true">
      <figure class="hero__proof-card">
        <picture>
          <source
            type="image/avif"
            srcset="/images/brand/glass-logo-600.avif 600w, /images/brand/glass-logo-800.avif 800w"
            sizes="280px"
          />
          <source
            type="image/webp"
            srcset="/images/brand/glass-logo-600.webp 600w, /images/brand/glass-logo-800.webp 800w"
            sizes="280px"
          />
          <img
            src="/images/brand/glass-logo-800.webp"
            alt=""
            width="800"
            height="801"
            loading="eager"
            decoding="async"
          />
        </picture>
        <figcaption>London BS Ltd — Dunstable</figcaption>
      </figure>
    </div>

  </div>
</section>

<div class="trust-bar">
  <div class="container">
    <ul class="trust-bar__list">
      <li><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>NICEIC registered</li>
      <li><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>EICR reports issued</li>
      <li><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Consumer unit upgrades</li>
      <li><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>House rewires &amp; fault finding</li>
      <li><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Dunstable &middot; Luton &middot; Milton Keynes</li>
      <li><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Selected London projects by arrangement</li>
    </ul>
  </div>
</div>


<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="section-head__label">What we do</span>
      <h2 class="section-head__title">Five services. Done properly.</h2>
      <p class="section-head__body">Electrical work and air conditioning for homeowners, landlords, and small businesses. If you need one of these, we can help.</p>
    </div>
    <div class="services-grid">
      <article class="service-card">
        <div class="service-card__icon"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
        <h3 class="service-card__title">EICR</h3>
        <p class="service-card__body">An Electrical Installation Condition Report checks the safety of the fixed wiring in your property. Required for rental properties and often requested by buyers, sellers, and insurers.</p>
        <a href="/eicr" class="service-card__link">EICR certificates in Dunstable <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </article>
      <article class="service-card">
        <div class="service-card__icon"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></div>
        <h3 class="service-card__title">Landlord EICR</h3>
        <p class="service-card__body">Private landlords in England must have a valid EICR in place. We carry out landlord electrical inspections and issue certificates that meet the legal requirements.</p>
        <a href="/landlord-eicr" class="service-card__link">Landlord EICR certificates <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </article>
      <article class="service-card">
        <div class="service-card__icon"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div>
        <h3 class="service-card__title">House Rewires</h3>
        <p class="service-card__body">Old wiring is a safety risk. A full or partial rewire replaces deteriorated cables and brings your installation up to current standards, with certificates on completion.</p>
        <a href="/rewires" class="service-card__link">House rewires in Dunstable <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </article>
      <article class="service-card">
        <div class="service-card__icon"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2M8 11h8M8 15h5"/></svg></div>
        <h3 class="service-card__title">Consumer Unit Changes</h3>
        <p class="service-card__body">An old fuse board without proper RCD protection is a common EICR failure point. We replace outdated consumer units with modern boards that meet current safety standards.</p>
        <a href="/consumer-unit-upgrades" class="service-card__link">Consumer unit replacements <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </article>
      <article class="service-card">
        <div class="service-card__icon"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"/></svg></div>
        <h3 class="service-card__title">Air Conditioning</h3>
        <p class="service-card__body">Split system air conditioning for homes and small businesses. Single and multi-split installations for bedrooms, home offices, loft conversions, and commercial spaces — supplied, fitted, and commissioned by a F-Gas registered engineer.</p>
        <a href="/air-conditioning-installation" class="service-card__link">Air conditioning installation <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </article>
    </div>
  </div>
</section>

{/*
  TODO(owner): please confirm before publishing:
  - The description of local housing (older homes with original fuse boards, rental properties needing EICRs) matches what you see in Dunstable.
*/}
<section class="section local-section">
  <div class="container">
    <div class="content-body local-section__body">
      <span class="section-head__label">Local to LU6</span>
      <h2 class="section-head__title">Electrical work in Dunstable</h2>
      <p>London BS Ltd is based at Meadway in Dunstable, LU6. Dunstable is our home area, so there is no travel charge for jobs in the town.</p>
      <p>As well as Dunstable town centre, we cover the villages and towns around it, including Houghton Regis, Totternhoe, Kensworth, Eaton Bray and Caddington. If you are not sure whether your address is covered, call and ask.</p>
      <p>Much of the electrical work around Dunstable comes down to the age of the housing. Older homes often still have their original fuse board, with little or no RCD protection. A <a href="/consumer-unit-upgrades" class="inline-link">consumer unit upgrade</a> replaces it with a modern board that meets current standards. Where the wiring itself has deteriorated, a full or partial <a href="/rewires" class="inline-link">rewire</a> may be the better option, and we will explain the difference before you decide.</p>
      <p>Rental properties need attention too. Private landlords in England must hold a valid EICR, renewed at least every five years. We carry out <a href="/landlord-eicr" class="inline-link">landlord EICRs</a> for rental properties and <a href="/eicr" class="inline-link">EICR reports</a> for homeowners, buyers and sellers.</p>
      <p>If something has stopped working, such as a circuit that keeps tripping or a socket with no power, our <a href="/fault-finding" class="inline-link">fault finding</a> service traces the cause before any repair is made.</p>
      <p>All work is carried out to BS 7671 and certified on completion.</p>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <span class="section-head__label">EICR focus</span>
    <h2 class="section-head__title" style="margin-bottom:0.8rem;">EICR is a legal requirement for landlords</h2>
    <p style="font-size:0.97rem; color:var(--ink-light); margin-bottom:1rem; line-height:1.74; max-width:620px;">Since 2020, private landlords in England must have an Electrical Installation Condition Report in place and renewed every five years. The certificate must be issued by a qualified person and meet the standards set out in current electrical regulations.</p>
    <p style="font-size:0.97rem; color:var(--ink-light); margin-bottom:1.35rem; line-height:1.74; max-width:620px;">As a NICEIC registered contractor, London BS Ltd issues EICR certificates that satisfy this requirement. If your EICR is due or overdue, get in touch and we will sort it.</p>
    <div style="display:flex; gap:0.85rem; flex-wrap:wrap;">
      <a href="/eicr" class="btn btn--outline-brown">About EICR</a>
      <a href="/landlord-eicr" class="btn btn--primary">Landlord EICR</a>
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="container">
    <div class="section-head">
      <span class="section-head__label">Why choose us</span>
      <h2 class="section-head__title">What you get from London BS Ltd</h2>
      <p class="section-head__body">We won't make claims we can't back up. Here is what we genuinely offer on every job.</p>
    </div>
    <div class="features-grid">
      <div class="feature-item"><div class="feature-item__icon"><svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div><p class="feature-item__title">NICEIC registered</p><p class="feature-item__body">Our work is assessed and approved by NICEIC. You can verify our registration directly on the NICEIC website.</p></div></div>
      <div class="feature-item"><div class="feature-item__icon"><svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div><div><p class="feature-item__title">Certificates issued</p><p class="feature-item__body">Every job that requires certification — EICR, Electrical Installation Certificate, Part P — is documented properly.</p></div></div>
      <div class="feature-item"><div class="feature-item__icon"><svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div><p class="feature-item__title">Honest pricing</p><p class="feature-item__body">We quote for the job as described. If something changes on site, we discuss it before proceeding.</p></div></div>
      <div class="feature-item"><div class="feature-item__icon"><svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div><p class="feature-item__title">Clear timescales</p><p class="feature-item__body">We tell you when we can carry out the work and what is involved before we start.</p></div></div>
      <div class="feature-item"><div class="feature-item__icon"><svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div><div><p class="feature-item__title">Based in Dunstable</p><p class="feature-item__body">Local to Dunstable, Houghton Regis, Luton and Leighton Buzzard. No inflated call-out charges.</p></div></div>
      <div class="feature-item"><div class="feature-item__icon"><svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.13 1 .36 1.97.71 2.9a2 2 0 0 1-.45 2.11L7.91 8.91A16 16 0 0 0 15.1 16.1l.96-.96a2 2 0 0 1 2.11-.45c.93.35 1.9.58 2.9.71a2 2 0 0 1 1.73 2.02Z"/></svg></div><div><p class="feature-item__title">Easy to reach</p><p class="feature-item__body">Call or send an enquiry. We respond promptly and do not pressure or chase.</p></div></div>
    </div>
  </div>
</section>

<section class="section section--alt reviews-section">
  <div class="container">
    <div class="section-head">
      <span class="section-head__label">Customer reviews</span>
      <h2 class="section-head__title">Rated {googleRating} out of 5 by our customers</h2>
      <p class="section-head__body">We let our work speak for itself. Homeowners and landlords across Dunstable, Luton and Milton Keynes consistently rate London BS Ltd five stars — on Google and on Rated People.</p>
    </div>
    <div class="reviews-stats">
      <a href={googleReviews.url} target="_blank" rel="noopener noreferrer" class="review-stat">
        <div class="review-stat__stars" aria-hidden="true">★★★★★</div>
        <p class="review-stat__score">{googleRating}</p>
        <p class="review-stat__source">{googleReviews.count} Google reviews</p>
        <span class="review-stat__cta">Read on Google →</span>
      </a>
      <a href={ratedPeopleReviews.url} target="_blank" rel="noopener noreferrer" class="review-stat">
        <div class="review-stat__stars" aria-hidden="true">★★★★★</div>
        <p class="review-stat__score">{ratedPeopleRating}</p>
        <p class="review-stat__source">{ratedPeopleReviews.count} verified reviews</p>
        <span class="review-stat__cta">Read on Rated People →</span>
      </a>
    </div>
    <div class="review-quotes">
      <figure class="review-quote">
        <blockquote>Lukasz did a great job. The price was fair, he turned up bang on time, did the work quickly and neatly, and was extremely courteous throughout. I wouldn't hesitate to use him again, and fully recommend him.</blockquote>
        <figcaption>Sadakat, W10 &middot; Rated People, March 2025</figcaption>
      </figure>
      <figure class="review-quote">
        <blockquote>Very good and prompt communication in arranging work and all carried out exactly as agreed. Very professional, and friendly as well.</blockquote>
        <figcaption>Paul, SW1P &middot; Rated People, October 2022</figcaption>
      </figure>
      <figure class="review-quote">
        <blockquote>Excellent job. Minimum fuss, very tidy, also did a couple of bits of sealant that were loose without charging extra.</blockquote>
        <figcaption>Suzanne, NW6 &middot; Rated People, January 2018</figcaption>
      </figure>
    </div>
    <p class="reviews-note">Previously based in Borehamwood, now in Dunstable.</p>
    <div class="reviews-verified">
      <p class="reviews-verified__label">Independently verified on Rated People</p>
      <ul class="reviews-verified__list">
        <li>ID checked</li>
        <li>Credit checked</li>
        <li>Address checked</li>
        <li>Fraud checked</li>
        <li>Member for 11+ years</li>
      </ul>
    </div>
  </div>
</section>

<section class="section accreditations-section">
  <div class="container">
    <div class="section-head">
      <span class="section-head__label">Accreditations</span>
      <h2 class="section-head__title">Verified. Registered. Accountable.</h2>
      <p class="section-head__body">Our NICEIC registration means our work is independently assessed against national standards. You can verify us directly on the NICEIC website.</p>
    </div>
    <div class="accreditations-grid">
      <div class="accreditation-card">
        <img src="/images/niceic-badge.webp" alt="NICEIC Registered Competent Person Electrical" class="accreditation-card__badge" width="250" height="84" loading="lazy">
        <div class="accreditation-card__body">
          <h3 class="accreditation-card__title">NICEIC Registered</h3>
          <p class="accreditation-card__text">London BS Ltd is a NICEIC Registered Competent Person for electrical work. NICEIC is the UK's leading electrical contracting body — membership requires ongoing assessment of technical competence and compliance with BS 7671 wiring regulations.</p>
          <ul class="accreditation-card__list">
            <li>Independently assessed by NICEIC</li>
            <li>Authorised to self-certify notifiable electrical work (Part P)</li>
            <li>All work carried out to BS 7671 18th Edition</li>
            <li>Certificates issued on completion of every job</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<LukasSection />

<TikTokSection />

<section class="section section--alt">
  <div class="container">
    <div class="section-head">
      <span class="section-head__label">Useful information</span>
      <h2 class="section-head__title">Helpful guides</h2>
      <p class="section-head__body">Answers to common questions about electrical safety, EICR certificates, and when to get work done.</p>
    </div>
    <div class="support-links">
      <a href="/guides/eicr-codes-explained" class="support-link">EICR codes explained — what C1, C2 and C3 mean <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/guides/what-fails-an-eicr" class="support-link">What commonly fails an EICR <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/guides/how-often-is-an-eicr-needed" class="support-link">How often is an EICR needed? <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/guides/signs-your-house-needs-rewiring" class="support-link">Signs your house may need rewiring <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/guides/when-to-replace-a-fuse-box" class="support-link">When to replace your fuse box <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section-head">
      <span class="section-head__label">Where we work</span>
      <h2 class="section-head__title">Service areas</h2>
      <p class="section-head__body">Based in Dunstable, we cover the surrounding area for EICR reports, consumer unit upgrades, rewires and fault finding.</p>
    </div>
    <div class="area-links">
      {locations.map(loc => (
        <a href={loc.href ?? `/${loc.slug}`} class="area-link">
