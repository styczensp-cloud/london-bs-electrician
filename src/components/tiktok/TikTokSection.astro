---
// ─── Add real TikTok video IDs here ─────────────────────────────────────────
// How to find an ID: open any video on https://www.tiktok.com/@london_bs_ltd
// Copy the URL — the long number at the end is the ID:
//   https://www.tiktok.com/@london_bs_ltd/video/7234567890123456789
//                                                ^^^^^^^^^^^^^^^^^^^
//
// Leave this array empty ([]) to show the compact follow section only.
// Max 3 videos. Any entry without a numeric ID is silently skipped.
//
// Thumbnail (optional — improves load performance):
//   Screenshot the video portrait-cropped (~315×560px)
//   Save to /public/images/tiktok/ and add the path below.
// ─────────────────────────────────────────────────────────────────────────────

import TikTokEmbed from './TikTokEmbed.astro';
import TikTokButton from './TikTokButton.astro';

interface Video {
  id: string;
  title: string;
  thumbnail?: string;
}

const rawVideos: Video[] = [
  // {
  //   id: '7234567890123456789',
  //   title: 'When the customer says "I did it myself"',
  //   thumbnail: '/images/tiktok/video-1.jpg',
  // },
  // {
  //   id: '7234567890123456790',
  //   title: 'Fuse box roulette',
  // },
  // {
  //   id: '7234567890123456791',
  //   title: 'Part P? Never heard of her',
  // },
];

// Only pass through entries with a non-empty numeric-looking ID
const videos = rawVideos
  .filter((v) => /^\d{10,}$/.test(v.id.trim()))
  .slice(0, 3);

const hasVideos = videos.length > 0;
---

<section class="section section--dark tt-section" class:list={{ 'tt-section--compact': !hasVideos }}>
  <div class="container">

    <div class="tt-social-row">
      <!-- TikTok icon -->
      <svg class="tt-social-row__icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.79a8.18 8.18 0 0 0 4.78 1.52V6.86a4.85 4.85 0 0 1-1.01-.17z"/>
      </svg>

      <div class="tt-social-row__text">
        <span class="section-head__label">On TikTok</span>
        <h2 class="tt-social-row__title">Electrical humour from London BS Ltd</h2>
        <p class="tt-social-row__body">Satire, site humour and short electrical clips. Not a portfolio — just the lighter side of the trade.</p>
      </div>

      <div class="tt-social-row__action">
        <TikTokButton label="Follow London BS on TikTok" />
      </div>
    </div>

    {hasVideos && (
      <div class="tt-grid">
        {videos.map((v) => (
          <TikTokEmbed
            videoId={v.id}
            title={v.title}
            thumbnail={v.thumbnail}
          />
        ))}
      </div>
    )}

  </div>
</section>

<style>
  .tt-section {
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  /* Compact layout: icon + text + button in one row on wider screens */
  .tt-social-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .tt-social-row__icon {
    flex-shrink: 0;
    opacity: 0.55;
    align-self: flex-start;
    margin-top: 0.15rem;
  }

  .tt-social-row__text {
    flex: 1;
    min-width: 0;
  }

  /* Override the global section-head__label margin when used inline */
  .tt-social-row__text .section-head__label {
    margin-bottom: 0.3rem;
  }

  .tt-social-row__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.8vw, 1.7rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 0.35rem;
  }

  .tt-social-row__body {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.6;
    margin: 0;
    max-width: 480px;
  }

  .tt-social-row__action {
    flex-shrink: 0;
  }

  @media (max-width: 580px) {
    .tt-social-row {
      gap: 0.9rem;
    }
    .tt-social-row__action {
      width: 100%;
    }
  }

  /* Video grid — only rendered when videos are present */
  .tt-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-top: 2rem;
    max-width: 760px;
  }

  @media (max-width: 580px) {
    .tt-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 420px;
    }
  }

  @media (max-width: 360px) {
    .tt-grid {
      grid-template-columns: 1fr;
      max-width: 260px;
    }
  }
</style>
