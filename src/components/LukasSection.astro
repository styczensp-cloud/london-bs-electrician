---
// "Meet Lukas" — compact profile section, not a hero
---

<section class="section section--alt lukas-section">
  <div class="container">
    <div class="lukas-inner">

      <div class="lukas-photo-wrap">
        <picture>
          <source
            type="image/avif"
            srcset="/images/lukas/lukas-300.avif 300w, /images/lukas/lukas-600.avif 600w"
            sizes="(max-width: 480px) 140px, 180px"
          />
          <source
            type="image/webp"
            srcset="/images/lukas/lukas-300.webp 300w, /images/lukas/lukas-600.webp 600w"
            sizes="(max-width: 480px) 140px, 180px"
          />
          <img
            src="/images/lukas/lukas-300.jpg"
            alt="Lukas from London BS Ltd"
            width="300"
            height="300"
            loading="lazy"
            decoding="async"
            class="lukas-photo"
          />
        </picture>
      </div>

      <div class="lukas-body">
        <span class="section-head__label">Who we are</span>
        <h2 class="lukas-name">Lukas Gryko</h2>
        <p class="lukas-role">Director &amp; Lead Electrician &middot; London BS Ltd</p>
        <p class="lukas-bio">NICEIC registered and based in Dunstable. Lukas carries out every job personally — EICR certificates, consumer unit replacements, house rewires, and air conditioning. No subcontracting, no surprises.</p>
        <ul class="lukas-badges">
          <li>
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            NICEIC Registered
          </li>
          <li>
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            F-Gas Registered
          </li>
          <li>
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Based in Dunstable LU6
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .lukas-section {
    padding-top: 2.75rem;
    padding-bottom: 2.75rem;
  }

  .lukas-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Photo */
  .lukas-photo-wrap {
    flex-shrink: 0;
  }

  .lukas-photo {
    display: block;
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--cream-dark);
    box-shadow: var(--shadow);
  }

  /* Text */
  .lukas-body {
    min-width: 0;
  }

  .lukas-name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0.3rem 0 0.2rem;
  }

  .lukas-role {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--brown);
    letter-spacing: 0.03em;
    margin: 0 0 0.8rem;
  }

  .lukas-bio {
    font-size: 0.93rem;
    color: var(--ink-light);
    line-height: 1.7;
    margin: 0 0 0.9rem;
    max-width: 520px;
  }

  .lukas-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-light);
  }

  .lukas-badges li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lukas-badges li svg {
    color: var(--brown);
    flex-shrink: 0;
  }

  /* Mobile: stack vertically, photo smaller */
  @media (max-width: 520px) {
    .lukas-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }

    .lukas-photo {
      width: 140px;
      height: 140px;
    }
  }
</style>
