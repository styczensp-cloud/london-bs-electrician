---
const nav = [
  { label: 'EICR',             href: '/eicr' },
  { label: 'Landlord EICR',    href: '/landlord-eicr' },
  { label: 'Rewires',          href: '/rewires' },
  { label: 'Consumer Units',   href: '/consumer-unit-upgrades' },
  { label: 'Air Con',          href: '/air-conditioning-installation' },
  { label: 'Areas',            href: '/service-areas' },
];
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="London BS Ltd home">
      <img src="/images/logo.webp" alt="London BS Ltd" class="logo__img">
      <div class="logo__text">
        <span class="logo__name">London BS Ltd</span>
        <span class="logo__tag">NICEIC Registered · Dunstable</span>
      </div>
    </a>

    <nav class="nav desktop-nav" aria-label="Main navigation">
      {nav.map(({ label, href }) => (
        <a href={href}>{label}</a>
      ))}
      <a href="/contact" class="nav-cta">Get a Quote</a>
    </nav>

    <a href="tel:07427670610" class="header-call" aria-label="Call London BS Ltd">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.13 1 .36 1.97.71 2.9a2 2 0 0 1-.45 2.11L7.91 8.91A16 16 0 0 0 15.1 16.1l.96-.96a2 2 0 0 1 2.11-.45c.93.35 1.9.58 2.9.71a2 2 0 0 1 1.73 2.02Z"/></svg>
      07427 670610
    </a>

    <button class="hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" aria-label="Mobile navigation">
    <a href="/">Home</a>
    {nav.map(({ label, href }) => (
      <a href={href}>{label}</a>
    ))}
    <a href="/contact">Get a Quote</a>
    <a href="tel:07427670610">&#128222; 07427 670610</a>
  </nav>
</header>
