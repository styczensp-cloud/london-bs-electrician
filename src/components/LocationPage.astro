---
import Layout from '../layouts/Layout.astro';
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
const {
  name, slug, postcode, nearbyAreas,
  title, metaDescription,
  intro, eicrText, consumerUnitText, faultFindingText, rewiresText, emergencyText,
  faqs,
} = location;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = `${site}/${slug}`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${site}/` },
      { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": `${site}/service-areas` },
      { "@type": "ListItem", "position": 3, "name": `Electrician in ${name}`, "item": pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": `Electrician in ${name}`,
    "serviceType": "Electrical Contractor",
    "provider": {
      "@type": "LocalBusiness",
      "name": "London BS Ltd",
      "url": site,
      "telephone": "07427670610",
    },
    "areaServed": {
      "@type": "City",
      "name": name,
      "address": { "@type": "PostalAddress", "postalCode": postcode, "addressCountry": "GB" },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(({ q, a }) => ({
      "@type": "Question",
      "name": q,
      "acceptedAnswer": { "@type": "Answer", "text": a },
    })),
  },
];

// Check icon SVG reused across service items
const checkSvg = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`;
---

<Layout title={title} description={metaDescription} schema={schema}>

<section class="page-hero">
  <div class="container">
    <nav class="page-hero__breadcrumb">
      <a href="/">Home</a><span>›</span>
      <a href="/service-areas">Service Areas</a><span>›</span>
      <span aria-current="page">Electrician in {name}</span>
    </nav>
    <p class="page-hero__label">Electrician · {name} · {postcode}</p>
    <h1 class="page-hero__title">Electrician in {name}</h1>
    <p class="page-hero__body">{intro}</p>
    <div class="page-hero__cta">
      <a href="/contact" class="btn btn--primary btn--lg">Get a Quote</a>
      <a href="tel:07427670610" class="btn btn--outline btn--lg">Call 07427 670610</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="service-layout">
      <div class="content-body">

        <div class="niceic-note">
          <span class="niceic-note__badge">NICEIC Registered</span>
          <span class="niceic-note__text">All electrical work carried out by London BS Ltd is completed by a NICEIC registered electrician. Work is certificated and, where required, notified to Building Control.</span>
        </div>

        <h2>Electrical services in {name}</h2>
        <ul class="check">
          <li>EICR reports (Electrical Installation Condition Reports)</li>
          <li>Landlord EICR reports — satisfying the legal five-year requirement</li>
          <li>Consumer unit upgrades — replacing outdated fuseboards</li>
          <li>Fault finding — tracing and repairing electrical faults</li>
          <li>House rewires — full and partial</li>
          <li>Emergency electrical work</li>
          <li>Domestic and commercial electrical work</li>
        </ul>

        <h2>EICR reports in {name}</h2>
        <p>{eicrText}</p>
        <p>For full details on what an EICR involves and who needs one, see our <a href="/eicr" class="inline-link">EICR page</a> and the <a href="/landlord-eicr" class="inline-link">landlord EICR page</a>.</p>

        <h2>Consumer unit upgrades in {name}</h2>
        <p>{consumerUnitText}</p>
        <p>For more information, see our <a href="/consumer-unit-changes" class="inline-link">consumer unit changes page</a> or our guide on <a href="/guides/when-to-replace-a-fuse-box" class="inline-link">when to replace a fuse box</a>.</p>

        <h2>Fault finding in {name}</h2>
        <p>{faultFindingText}</p>

        <h2>House rewires in {name}</h2>
        <p>{rewiresText}</p>
        <p>For more detail see our <a href="/rewires" class="inline-link">house rewires page</a>.</p>

        <h2>Emergency electrician in {name}</h2>
        <p>{emergencyText}</p>

        <h2 style="margin-top:2.5rem;">Frequently asked questions</h2>
        <div class="faq-list" style="margin-top:1rem;">
          {faqs.map(({ q, a }) => (
            <div class="faq-item">
              <button class="faq-q" aria-expanded="false">{q}<span class="faq-icon">+</span></button>
              <div class="faq-a">{a}</div>
            </div>
          ))}
        </div>

      </div>

      <aside class="sidebar">
        <div class="sidebar-box">
          <p class="sidebar-box__title">Get a quote in {name}</p>
          <p class="sidebar-box__body">Tell us your property details and we'll come back with a clear price.</p>
          <a href="/contact" class="btn btn--primary">Send an Enquiry</a>
          <p class="sidebar-box__body" style="margin-top:0.65rem; margin-bottom:0.35rem;">Or call directly:</p>
          <a href="tel:07427670610" class="sidebar-box__phone">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.13 1 .36 1.97.71 2.9a2 2 0 0 1-.45 2.11L7.91 8.91A16 16 0 0 0 15.1 16.1l.96-.96a2 2 0 0 1 2.11-.45c.93.35 1.9.58 2.9.71a2 2 0 0 1 1.73 2.02Z"/></svg>
            07427 670610
          </a>
          <div class="sidebar-related">
            <p class="sidebar-related__label">Main services</p>
            <a href="/eicr"><svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>EICR Reports</a>
            <a href="/landlord-eicr"><svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>Landlord EICR</a>
            <a href="/consumer-unit-changes"><svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>Consumer Unit Upgrades</a>
            <a href="/rewires"><svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>House Rewires</a>
          </div>
          {nearbyAreas.length > 0 && (
            <div class="sidebar-related">
              <p class="sidebar-related__label">Nearby areas</p>
              {nearbyAreas.map(area => (
                <a href={`/service-areas`}>
                  <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  {area}
                </a>
              ))}
            </div>
          )}
        </div>
      </aside>

    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <h2 class="cta-band__title">Need an electrician in {name}?</h2>
    <p class="cta-band__body">Get in touch for a quote. We cover {name}, {nearbyAreas.slice(0, 2).join(', ')} and surrounding areas.</p>
    <div class="cta-band__actions">
      <a href="/contact" class="btn btn--outline btn--lg">Request a Quote</a>
      <a href="tel:07427670610" class="btn btn--outline btn--lg">Call 07427 670610</a>
    </div>
  </div>
</section>

</Layout>
