---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: object | object[];
}

const {
  title,
  description = 'London BS Ltd — NICEIC registered electrician based in Dunstable. EICR certificates, house rewires, and consumer unit replacements across Dunstable, Luton and Leighton Buzzard.',
  canonical,
  schema
} = Astro.props;

const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {canonical && <link rel="canonical" href={canonical}>}
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {schemaArray.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <slot name="head" />
</head>
<body>
  <Header />
  <slot />
  <Footer />
  <script src="/script.js" is:inline></script>
</body>
</html>
